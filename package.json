    "typescript",
    "cucumber",
    "bdd",
    "gherkin",
    "test-automation",
    "page-object-model"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "playwright-bdd": "^9.2.0"
  }
}
